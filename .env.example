# Copie este arquivo para ".env" e preencha.
# A chave sai do portal https://developer.riotgames.com (login com a conta Riot).
# Chave de desenvolvimento expira a cada 24h; a chave pessoal (Personal API Key) não expira.
# NUNCA publique esta chave (GitHub, print, chat). O .env já está no .gitignore.
RIOT_API_KEY=RGAPI-coloque-a-sua-chave-aqui

# Seu Riot ID no formato Nome#TAG. Para várias contas, separe por vírgula.
RIOT_ID=SeuNome#BR1

# Servidor da conta (br1 = Brasil) e a região de roteamento da Match-V5 (americas para BR/NA/LAN/LAS).
RIOT_PLATFORM=br1
RIOT_REGION=americas

# Limites da sua chave. Os padrões são os da chave de desenvolvimento e da pessoal.
RIOT_LIMITE_POR_SEGUNDO=20
RIOT_LIMITE_POR_2_MINUTOS=100

# Onde fica o banco SQLite com tudo o que foi baixado.
DB_PATH=data/lol.db
